# Copy this file to .env.local and fill in your own values.
# Never commit .env.local — it is already in .gitignore.

# Google Gemini API key (https://aistudio.google.com/apikey).
# Used server-side only, by app/api/raza-ai/route.ts. Never exposed to the browser.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. Defaults to "gemini-flash-latest", Google's auto-updating alias for
# its current fast/cheap model. Set a specific model id here to pin a version.
# GEMINI_MODEL=gemini-flash-latest
